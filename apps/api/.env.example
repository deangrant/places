# Listen port (default 8787).
PORT=8787

# Comma-separated browser origins allowed by CORS.
# Prefer http://localhost:5173. If Vite bumps ports because earlier ones are
# busy, add the origin Vite printed (or free the stale Vite processes).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Nominatim usage identity (required).
# Use a real app name + reachable email. Domains like example.com are rejected
# by nominatim.openstreetmap.org with HTTP 403.
# See https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=PlacesExplorer/1.0 (your-email@example.org)
NOMINATIM_EMAIL=your-email@example.org

# Optional overrides:
# NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/search
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter
