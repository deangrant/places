{
  "name": "api",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm --filter places-core build && tsc -p tsconfig.build.json && node ./scripts/dev-watch.mjs",
