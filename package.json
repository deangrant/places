{
  "name": "places",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "MIT",
  "author": "Dean Grant",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter places-core build && pnpm --filter api build && pnpm --filter web build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "doctor": "react-doctor",
    "doctor:changed": "react-doctor --verbose --scope changed --yes",
    "doctor:full": "react-doctor --verbose --yes",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:lockfile": "pnpm install --frozen-lockfile",
    "preview": "pnpm --filter web preview",
    "test": "pnpm --filter places-core test && pnpm --filter api test && pnpm --filter web test"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "react-doctor": "catalog:",
    "ultracite": "catalog:"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  }
}
